{
  "name": "snes-rs",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./_site"
  },
  "routes": [
    { "pattern": "rw-access.dev/play/snes-rs", "zone_name": "rw-access.dev" },
    { "pattern": "rw-access.dev/play/snes-rs/*", "zone_name": "rw-access.dev" },
    { "pattern": "www.rw-access.dev/play/snes-rs", "zone_name": "rw-access.dev" },
    { "pattern": "www.rw-access.dev/play/snes-rs/*", "zone_name": "rw-access.dev" },
    { "pattern": "rw-access.dev/snes-rs", "zone_name": "rw-access.dev" },
    { "pattern": "rw-access.dev/snes-rs/*", "zone_name": "rw-access.dev" },
    { "pattern": "www.rw-access.dev/snes-rs", "zone_name": "rw-access.dev" },
    { "pattern": "www.rw-access.dev/snes-rs/*", "zone_name": "rw-access.dev" }
  ]
}
